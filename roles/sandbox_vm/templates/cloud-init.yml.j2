#cloud-config
# Managed by aap-sandbox-project.
users:
  - name: {{ sandbox_vm_ssh_user | to_json }}
    sudo:
      - "ALL=(ALL) NOPASSWD: ALL"
    groups:
      - wheel
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - {{ __sandbox_vm_public_key | to_json }}
ssh_pwauth: false
disable_root: true
